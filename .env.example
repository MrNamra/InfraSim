# App URLs
APP_NAME=InfraSim
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Postgres (docker-compose)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=infrasim
DB_USERNAME=infrasim
DB_PASSWORD=infrasim_dev_password

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# Laravel / Sanctum
APP_KEY=
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
SESSION_DRIVER=redis
SESSION_DOMAIN=localhost

# Pricing sync (backend only, public APIs)
PRICE_SYNC_ENABLED=false
AWS_PRICING_INDEX_URL=https://pricing.us-east-1.amazonaws.com/offers/v1.0/aws/index.json
AZURE_PRICING_API_URL=https://prices.azure.com/api/retail/prices
GCP_BILLING_API_URL=https://cloudbilling.googleapis.com/v1
GCP_BILLING_API_KEY=
OCI_PRICING_API_URL=https://apexapps.oracle.com/pls/apex/cetools/api/v1/products/

# Optional AI explanation summary endpoint (off by default)
EXPLAIN_ENABLED=false
EXPLAIN_PROVIDER_KEY=
