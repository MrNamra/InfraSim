{
  "kind": "auth",
  "description": "Identity provider issuing and verifying authentication tokens.",
  "icon": "auth",
  "scope": "regional",
  "ports": [{ "protocol": "https", "port": 443 }],
  "tags": ["auth", "iam", "cognito", "oauth", "jwt", "identity"],
  "failure": {
    "errorRate": 0.0001,
    "kinds": [
      {
        "kind": "throttled",
        "statusCode": 429,
        "name": "TooManyRequestsException",
        "message": "Identity quota throttled",
        "defaultRate": 0
      },
      {
        "kind": "server",
        "statusCode": 401,
        "name": "NotAuthorizedException",
        "message": "Invalid credentials or expired token",
        "defaultRate": 0
      }
    ]
  },
  "operations": [
    {
      "name": "Login",
      "summary": "Authenticate user credentials and issue token",
      "defaultResponse": {
        "statusCode": 200,
        "headers": { "content-type": "application/json" },
        "bodyTemplate": "{\"accessToken\":\"jwt.{{faker.hex(24)}}.sig\",\"expiresIn\":3600}",
        "sizeBytes": 512
      },
      "errors": []
    },
    {
      "name": "VerifyToken",
      "summary": "Validate JWT signature and claims",
      "defaultResponse": {
        "statusCode": 200,
        "headers": { "content-type": "application/json" },
        "bodyTemplate": "{\"valid\":true,\"sub\":\"{{faker.uuid}}\"}",
        "sizeBytes": 256
      },
      "errors": [],
      "idempotent": true
    },
    {
      "name": "Refresh",
      "summary": "Exchange refresh token for fresh access token",
      "defaultResponse": {
        "statusCode": 200,
        "headers": { "content-type": "application/json" },
        "bodyTemplate": "{\"accessToken\":\"jwt.{{faker.hex(24)}}.sig\",\"expiresIn\":3600}",
        "sizeBytes": 512
      },
      "errors": []
    }
  ]
}
