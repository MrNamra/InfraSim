{
  "kind": "compute",
  "description": "Programmable compute host running application handler code.",
  "icon": "compute",
  "scope": "zonal",
  "ports": [
    { "protocol": "http", "port": 8080 },
    { "protocol": "https", "port": 443 },
    { "protocol": "http", "port": 80 }
  ],
  "tags": ["vm", "server", "container", "api", "app", "backend", "compute"],
  "failure": {
    "errorRate": 0.0005,
    "kinds": [
      {
        "kind": "server",
        "statusCode": 500,
        "name": "InternalServerError",
        "message": "Unhandled handler failure",
        "defaultRate": 0.0005
      },
      {
        "kind": "dropped_queue_full",
        "statusCode": 503,
        "name": "ServiceUnavailable",
        "message": "Instance capacity queue saturated",
        "defaultRate": 0
      },
      {
        "kind": "timeout",
        "statusCode": 504,
        "name": "GatewayTimeout",
        "message": "Request exceeded compute timeout",
        "defaultRate": 0
      }
    ]
  },
  "operations": [
    {
      "name": "Invoke",
      "summary": "Handle an incoming HTTP or RPC request",
      "defaultResponse": {
        "statusCode": 200,
        "headers": { "content-type": "application/json" },
        "bodyTemplate": "{\"ok\":true,\"requestId\":\"{{faker.uuid}}\",\"ts\":\"{{now.iso}}\"}",
        "sizeBytes": 512
      },
      "errors": [
        {
          "kind": "server",
          "statusCode": 500,
          "name": "InternalServerError",
          "message": "Handler returned 500",
          "defaultRate": 0.0005
        }
      ],
      "idempotent": false
    }
  ]
}
