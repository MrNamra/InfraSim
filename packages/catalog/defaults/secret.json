{
  "kind": "secret",
  "description": "Managed secrets store with encryption at rest and API rate limits.",
  "icon": "secret",
  "scope": "regional",
  "ports": [{ "protocol": "https", "port": 443 }],
  "tags": ["secrets", "vault", "credentials", "ssm", "security"],
  "failure": {
    "errorRate": 0.0001,
    "kinds": [
      {
        "kind": "throttled",
        "statusCode": 429,
        "name": "ThrottlingException",
        "message": "Secret read rate limit exceeded",
        "defaultRate": 0
      },
      {
        "kind": "server",
        "statusCode": 403,
        "name": "AccessDeniedException",
        "message": "Access denied to secret",
        "defaultRate": 0
      }
    ]
  },
  "operations": [
    {
      "name": "GetSecret",
      "summary": "Retrieve secret string or binary value",
      "defaultResponse": {
        "statusCode": 200,
        "headers": { "content-type": "application/json" },
        "bodyTemplate": "{\"Name\":\"app/config\",\"VersionId\":\"{{faker.uuid}}\",\"SecretString\":\"{\\\"apiKey\\\":\\\"mock-{{faker.hex(16)}}\\\"}\"}",
        "sizeBytes": 256
      },
      "errors": [],
      "idempotent": true
    }
  ]
}
