{
  "name": "@infrasim/sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "import": "./dist/fixtures.js",
      "default": "./dist/fixtures.js"
    },
    "./doctor": {
      "types": "./dist/doctor.d.ts",
      "import": "./dist/doctor.js",
      "default": "./dist/doctor.js"
    },
    "./profile-key": {
      "types": "./dist/profileKey.d.ts",
      "import": "./dist/profileKey.js",
      "default": "./dist/profileKey.js"
    }
  },
  "dependencies": {
    "@infrasim/catalog": "workspace:*",
    "@infrasim/shared-types": "workspace:*",
    "esbuild-wasm": "^0.28.2",
    "quickjs-emscripten": "^0.32.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
