{
  "name": "infrasim-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @infrasim/web dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter './packages/*' build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "catalog:build": "tsx scripts/build-catalog.ts",
    "catalog:check": "tsx scripts/build-catalog.ts --check",
    "cost:coverage": "tsx scripts/check-price-coverage.ts --check",
    "cost:coverage:write": "tsx scripts/check-price-coverage.ts --write",
    "schema:generate": "pnpm --filter @infrasim/shared-types schema:generate",
    "schema:check": "pnpm --filter @infrasim/shared-types schema:check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.4",
    "ajv": "^8.20.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.1",
    "fast-check": "^4.10.2",
    "prettier": "^3.5.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.0.7"
  }
}
